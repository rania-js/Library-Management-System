module Library.Types

open System

/// حالة الكتاب: Discriminated Union بدل string أو bool
type BookStatus =
    | Available
    | Borrowed

/// الكتاب
type Book =
    { Id     : int
      Title  : string
      Author : string
      Genre  : string
      Status : BookStatus }

/// عملية استعارة (Loan) - بتتسجل لما حد يستعير كتاب
type Loan =
    { BookId     : int
      BorrowDate : DateTime }

/// حالة المكتبة كلها (immutable)
type Library =
    { Books : Map<int, Book>   // key = Book Id
      Loans : Map<int, Loan> } // key = Book Id (الاستعارات الحالية بس)

module Library =

    /// مكتبة فاضية - نقطة البداية
    let empty : Library =
        { Books = Map.empty
          Loans = Map.empty }

    /// يطلع Id جديد للكتاب (أكبر Id موجود + 1)
    let nextBookId (lib: Library) : int =
        match lib.Books |> Map.toSeq |> Seq.map fst |> Seq.tryLast with
        | Some maxId -> maxId + 1
        | None       -> 1
